{
  "name": "oru",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "NODE_OPTIONS='--experimental-strip-types' oxlint",
    "prepare": "lefthook install",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "lefthook": "^2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.2.1"
}
