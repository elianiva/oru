{
  "name": "@oru/host",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "oru-host": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-facets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vitest run test/e2e.test.ts",
    "dev": "node src/main.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@oru/chat-ui": "workspace:*",
    "@oru/harness": "workspace:*",
    "@oru/harness-claude-code": "workspace:*",
    "@oru/harness-pi": "workspace:*",
    "@oru/harness-registry": "workspace:*",
    "@oru/kernel": "workspace:*",
    "@oru/plugin-build": "workspace:*",
    "@oru/rpc": "workspace:*",
    "@oru/ui": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
