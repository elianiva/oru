{
  "name": "oru",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "turbo dev",
    "e2e": "turbo e2e",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "NODE_OPTIONS='--experimental-strip-types' oxlint",
    "prepare": "lefthook install",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "bump": "node scripts/bump-version.mjs",
    "check:lockstep": "node scripts/check-version-lockstep.mjs",
    "pack:host": "node scripts/pack-host.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "lefthook": "^2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.2.1"
}
