{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@oru/host#build": {
      "dependsOn": [
        "^build",
        "@oru/chat-ui#build",
        "@oru/harness-claude-code#build",
        "@oru/harness-opencode#build",
        "@oru/harness-pi#build"
      ],
      "outputs": ["dist/**"]
    },
    "oru#build": {
      "dependsOn": ["^build", "@oru/host#build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "cache": false
    }
  }
}
